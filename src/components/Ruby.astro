---
interface Props {
  rb: string;
  rt: string;
}

const { rb, rt } = Astro.props;
---

<span class="ruby">
  <ruby aria-hidden="true">
    <rb>{rb}</rb>
    <rp>(</rp>
    <rt>{rt}</rt>
    <rp>)</rp>
  </ruby>
  <span class="srText">{rt}</span>
</span>

<style>
rt {
  display: inline-block;
}

.ruby {
  position: relative;

  span {
    height: 1px;
    left: -10000px;
    overflow: hidden;
    position: absolute;
    top: auto;
    user-select: none;
    width: 1px;
  }
}

:global([data-hanja="off"]) {
  rb {
    display: none;
  }

  rt {
    font-size: inherit;
  }

  a rt {
    text-decoration: underline;
  }
}

:global([data-hanja="full"]) {
  rt {
    display: none;
  }
}
</style>
