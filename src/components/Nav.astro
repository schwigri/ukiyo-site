---
import { DEFAULT_LOCALE, getTranslations, toLocale } from "@/i18n";
import T from "@/components/T.astro";

const { s, t } = getTranslations(Astro.currentLocale);
const currentLocale = toLocale(Astro.currentLocale);
const homePath = currentLocale === DEFAULT_LOCALE ? "" : `/${Astro.currentLocale}`;
const isHome = Astro.url.pathname === homePath || Astro.url.pathname === `${homePath}/`;
---

<nav>
  <ul>
    <li>
      <a aria-current={isHome ? "page" : undefined} href={`${homePath}/`}>
        <T text={t`Home`} />
      </a>
    </li>
    <li>
      <a
        aria-current={Astro.url.pathname === s`/about-me/` ? "page" : undefined}
        href={s`/about-me.html`}
      >
        <T text={t`About me`} />
      </a>
    </li>
    <li>
      <a aria-current={Astro.url.pathname.startsWith(s`/blog/`) ? "page" : undefined} href={s`/blog/`}>
        <T text={t`Blog`} />
      </a>
    </li>
    <li>
      <a aria-current={Astro.url.pathname === s`/resume/` ? "page" : undefined} href={s`/resume.html`}>
        <T text={t`Résumé`} />
      </a>
    </li>
  </ul>
</nav>

<style>
a[aria-current] {
  color: inherit;
  font-weight: 700;
  text-decoration: none;
}

li:not(:last-child)::after {
  content: "•";
  margin-inline: 0.5em;
}

ul {
  align-items: baseline;
  display: inline-flex;
  list-style: none;
  margin: 0;
  padding: 0;
}

nav {
  margin-block-start: 1em;
  text-align: center;
}
</style>
