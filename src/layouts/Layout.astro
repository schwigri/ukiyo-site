---
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, toCode, getTranslations } from "@/i18n";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Logo from "@/components/Logo.astro";
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const t = getTranslations(Astro.currentLocale);
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8">
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {SUPPORTED_LOCALES.map((locale) => {
      const code = toCode(locale);
      const url = new URL(locale === DEFAULT_LOCALE ? "/" : `/${code}/`, Astro.site);
      return (
        <link
          href={url.toString()}
          hreflang={toCode(locale)}
          rel="alternate"
        />
      );
    })}
  </head>
  <body>
    <header>
      <Logo />

      <Nav />

      <nav aria-label={t`Languages`} class="languages">
        <LanguageSwitcher />
      </nav>
    </header>

    <main id="content">
      <slot />
    </main>
  </body>
</html>

<style>
main {
  margin-inline: auto;
  max-inline-size: 80ch;
}

nav {
  font-size: 0.875em;
  margin-block-start: 0.5em;
  text-align: center;
}

header {
  margin-block: 2em;
}
</style>
