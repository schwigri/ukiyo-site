---
import { SUPPORTED_LOCALES, toCode, getTranslations, translatePathname } from "@/i18n";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Logo from "@/components/Logo.astro";
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";

interface Props {
  description?: string;
  title: string;
}

const { description, title } = Astro.props;
const t = getTranslations(Astro.currentLocale);
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8">
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {description ? <meta name="description" content={description}> : null}
    <link rel="canonical" href={(new URL(Astro.url.pathname, Astro.site)).toString()} />
    {SUPPORTED_LOCALES.map((locale) => {
      const code = toCode(locale);
      if (code === Astro.currentLocale) {
        return (
          <link
            href={(new URL(Astro.url.pathname, Astro.site)).toString()}
            hreflang={code}
            rel="alternate"
          />
        );
      }

      const translatedPathname = translatePathname(Astro.url.pathname, locale);
      return translatedPathname ? (
        <link
          href={(new URL(translatedPathname, Astro.site)).toString()}
          hreflang={code}
          rel="alternate"
        />
      ) : null;
    })}
  </head>
  <body>
    <header>
      <Logo />

      <Nav />

      <nav aria-label={t`Languages`} class="languages">
        <LanguageSwitcher />
      </nav>
    </header>

    <hr>

    <main id="content">
      <slot />
    </main>

    <hr>

    <footer>
      <span>{t`Copyright © 2026 Griffen Schwiesow`}</span>
    </footer>
  </body>
</html>

<style>
footer {
  margin-block: 1em;

  span {
    font-size: 0.875em;
  }
}

#content {
  font-size: 1.25em;

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    line-height: 1;
    margin-block-start: 1em;
    margin-block-end: 0.5em;
  }

  ol,
  ul,
  p {
    line-height: 1.6;
    margin-block-end: 1em;
  }
}

main {
  margin-block: 2em;
  margin-inline: auto;
}

nav {
  font-size: 0.875em;
  margin-block-start: 0.5em;
  text-align: center;
}

header {
  margin-block: 2em;
}
</style>
