---
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import "@fontsource/reddit-mono/latin-200.css";
import "@fontsource/reddit-mono/latin-400.css";
import "@fontsource/reddit-sans/latin-300.css";
import "@fontsource/reddit-sans/latin-400.css";
import "@/styles/global.css";

interface Props {
  description: string;
  isHome?: boolean;
  title: string;
}

const { description, isHome = false, title } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://www.griffen.dev");
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta
      content="width=device-width,initial-scale=1.0,viewport-fit=cover"
      name="viewport"
    />
    <script src="@/scripts/griffen"></script>
    <link href={canonical.toString()} rel="canonical" />
    <link href="https://www.griffen.dev/" hreflang="en" />
    <link href="https://www.griffen.dev/fr/" hreflang="fr" />
  </head>
  <body class:list={["bg-theme fg-theme", "font-copy text-base"]}>
    <div class="overlay"></div>

    <Header isHome={isHome} />

    <div id="scroll-threshold"></div>

    <Main isHome={isHome}>
      <slot />
    </Main>
  </body>
</html>
