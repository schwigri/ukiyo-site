---
import Layout from "@/layouts/Layout.astro";
import { getTranslations } from "@/i18n";

const t = getTranslations(Astro.currentLocale);
---

<Layout
  description={"A designer and developer passionate about accessibility, internationalization and making the web a more beautiful space."}
  title={t`Griffen Schwiesow — ${t`Designer, front-end developer and accessibility specialist`}`}
>
  <h1>Home page</h1>
  <p>Hello! Thanks for visiting my site. I'm a front-end developer at Amazon where I have the opportunity to delight billions of customers around the world. I've been making websites since I was 13, and it only keeps getting more fun. If you're curious, <a href="/about-me.html">read more about me</a>. If you're a recruiter, <a href="/resume.html">check out my résumé</a>.</p>
  <h2>Most recent blog post</h2>
  <p>Looks like there isn't one, yet! But, one is in the works. Please check again later, or subscribe to my <a href="/feed.xml">RSS feed</a>.</p>
</Layout>
