---
import Hero from "@/components/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import Posts from "@/components/Posts.astro";
---

<Layout
  description="Je suis designer et développeur passionné par l'accessibilité, l'internationalisation et l'idée de rendre le web un espace plus beau."
  isHome={true}
  title="Griffen Schwiesow — Designer, développeur front-end et spécialiste en accessibilité"
>
  <Hero>
    <h2 class:list={["text-x-large"]}>Bonjour ! Je m’appelle Griffen.</h2>
    <p>
      Je suis designer et développeur passionné par l'accessibilité,
      l'internationalisation et l'idée de rendre le web un espace plus beau.
    </p>
    <ul
      aria-label="Les réseaux"
      class:list={["font-branding uppercase text-medium"]}
    >
      <li>
        <a
          class:list={["social-link", "fg-theme no-underline"]}
          href="https://sr.ht/~schwigri/"
        >
          <span>SourceHut</span>
        </a>
      </li>
    </ul>
  </Hero>

  <Posts />
</Layout>
