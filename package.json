{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@schwigri/ukiyo-site",
  "version": "1.0.0",
  "private": true,
  "description": "The source code for my personal blog",
  "homepage": "https://www.griffen.dev/",
  "bugs": {
    "url": "https://todo.sr.ht/~schwigri/ukiyo",
    "email": "~schwigri/ukiyo-devel@lists.sr.ht"
  },
  "license": "BSD-3-Clause",
  "author": "Griffen Schwiesow <gs@griffen.dev>",
  "type": "module",
  "scripts": {
    "build": "APP_ENV=production astro build",
    "dev": "astro dev",
    "format": "oxlint --fix . && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "prepare": "astro sync && husky",
    "prerelease": "npm run lint && npm run typecheck && npm run test",
    "preview": "APP_ENV=production astro preview",
    "serve": "astro serve",
    "test": "vitest --run --coverage",
    "typecheck": "astro check && npx tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@varlock/astro-integration": "^1.3.0",
    "astro": "^7.1.1",
    "varlock": "^1.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.74.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
