{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@schwigri/ukiyo-site",
  "version": "1.0.0",
  "private": true,
  "description": "The source code for my personal blog",
  "homepage": "https://www.griffen.dev/",
  "bugs": {
    "url": "https://todo.sr.ht/~schwigri/ukiyo",
    "email": "~schwigri/ukiyo-devel@lists.sr.ht"
  },
  "license": "BSD-3-Clause",
  "author": "Griffen Schwiesow <gs@griffen.dev>",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "format": "oxlint --fix && eslint --cache --fix . && prettier --cache --write .",
    "lint": "npm run typecheck && oxlint && eslint --cache . && prettier --cache --check .",
    "prepare": "astro sync",
    "preview": "astro preview",
    "serve": "astro serve",
    "typecheck": "astro check && npx tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/reddit-mono": "^5.2.8",
    "@fontsource/reddit-sans": "^5.2.7",
    "astro": "^5.16.6"
