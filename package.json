    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxlint": "^1.36.0",
    "jiti": "^2.6.1",
    "oxlint": "^1.36.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.51.0"
  }
